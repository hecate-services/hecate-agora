%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_agora.
%%
%% Keeper of the society public square: records every agora post the minds publish so the record outlives the speakers
%%
%% Scaffolded by `rebar3 new hecate_service', then given its record: a
%% Listener -> Policy -> Projection over each society's <ns>/agora topic, and
%% three query desks served as mesh capabilities.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health,
    %% supervised subscriptions (subscriptions/0) and the barrel_docdb read
    %% model (read_model_id/0 + data_dir/0) this service keeps its record in.
    %% barrel_docdb itself arrives transitively; the service module exports no
    %% store_id/0, so hecate_om wires the mesh and starts NO reckon-db. 0.23 is
    %% the line that carries subscriptions/0 and hecate_om_wire:unwrap/1.
    {hecate_om, "~> 0.23"},
    %% Explicit floor on the mesh SDK, above what hecate_om alone would pull:
    %% 10.17.0 fixes an `ordered' subscriber (macula_subscriber's default) going
    %% deaf after a station restart until that station's publish counter climbed
    %% back past its pre-restart value -- with every link, wire subscription and
    %% process looking healthy meanwhile. hecate-stations sat blind for 10+
    %% hours that way. This service IS such a subscriber, and a keeper that is
    %% deaf loses exactly the posts published while it was, unrecoverably. The
    %% floor is here so a fresh resolve can never land below the fix.
    {macula, "~> 10.17"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {hecate_agora, "0.1.0"}, [hecate_agora, sasl]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.

%% Dialyzer needs the deps this service actually calls in its PLT, or every
%% barrel_docdb call reads as an unknown function and the run reports nine
%% warnings that say nothing about this code. macula is deliberately NOT
%% listed: its hex package ships beams without debug info, so dialyzer cannot
%% build a PLT from them at all ("Could not get Core Erlang code"), and the
%% four "callback info about the macula_response/macula_subscriber behaviour
%% is not available" warnings that remain are that limitation, not a finding.
{dialyzer, [
    {plt_extra_apps, [barrel_docdb, hecate_om]},
    {warnings, [unknown]}
]}.
