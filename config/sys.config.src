%% Substituted by relx at boot; every ${VAR} must resolve or the node will not
%% start with a malformed term. That is the correct failure: a service with a
%% half-configured realm announces itself where nobody can attribute it, which
%% looks exactly like a healthy node.
[
    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        %% Without this, hecate_om_identity:load_keypair/0 returns `undefined`
        %% forever and keypair/0 stays {error, no_keypair} -- a service that
        %% declares a handler-bearing capability() then silently never
        %% advertises it, on every republish tick, permanently ("an
        %% ephemeral service cannot sign and is correctly not advertised",
        %% hecate_om_capabilities's own moduledoc). Confirmed live 2026-08-31
        %% on a service generated from an earlier copy of this template that
        %% lacked this line. Point it at the same mounted secrets volume
        %% service_cert_path already uses -- no new infrastructure needed.
        %% Under the DATA volume, not the secrets one: this keypair signs the
        %% service's own capability advertisements and nothing else, and it
        %% is generated on first boot if absent. Keeping it beside the record
        %% means a recreated container keeps its identity (same shape as
        %% hecate-citizens). ${HECATE_DATA_DIR} is set by the image and by
        %% every compose file, so it always resolves.
        {identity_key_path, "${HECATE_DATA_DIR}/identity/keypair.erl.bin"},
        {health_port,       ${HECATE_HEALTH_PORT}},
        {capability_topic,  <<"_mesh.cap.">>},
        %% THE REALM IS AN APPLICATION ENV, NOT A SHELL VARIABLE, and this file
        %% is the only place the two meet. hecate_om_identity:realm() reads
        %% application:get_env(hecate_om, realm); exporting HECATE_REALM in the
        %% shell and expecting that to be enough has cost a sibling service an
        %% hour, because nothing translates between the two by itself.
        {realm,             <<"${HECATE_REALM}">>}
    ]},
    {kernel, [{logger_level, info}]}
].
